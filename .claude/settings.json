{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(gh auth status)",
      "Bash(gh repo view:*)",
      "Bash(gh api:*)",
      "Bash(gh browse:*)",
      "Bash(python3:*)",
      "Bash(curl:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(open:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git stash:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Edit(.env)",
      "Write(.env)"
    ]
  }
}
